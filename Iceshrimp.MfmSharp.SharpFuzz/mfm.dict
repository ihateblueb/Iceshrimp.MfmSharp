#
# AFL dictionary for MFM
# ------------------------------
#

newline="\x0a"
space=" "

letters[]="abcdefghijklmnopqrstuvwxyz"

dot="."
comma=","
equals="="
colon=":"
slash="/"
tag_open="<"
tag_close=">"

italic_ast_open="*"
italic_ast_close="*"
italic_und_open="_"
italic_und_close="_"
italic_tag_open="<i>"
italic_tag_close="</i>"

bold_ast_open="**"
bold_ast_close="**"
bold_und_open="__"
bold_und_close="__"
bold_tag_open="<b>"
bold_tag_close="</b>"

strike_tld_open="~~"
strike_tld_close="~~"
strike_tag_open="<s>"
strike_tag_close="</s>"

mention_open="@"
mention_sep="@"

hashtag="#"

inline_code_open="`"
inline_code_close="`"

url_http="http://"
url_https="https://"

link_silent_text_open="?["
link_text_open="["
link_text_close="]"
link_text_close_full="]"
link_link_open="("
link_link_close=")"

plain_tag_open="<plain>"
plain_tag_close="</plain>"

small_tag_open="<small>"
small_tag_close="</small>"

url_brackets_http_open="<http://"
url_brackets_https_open="<https://"
url_brackets_close=">"

inline_math_open="\\("
inline_math_close="\\)"

fn_open="$["
fn_close="]"

code_block_open="```"
code_block_close="```"

quote_open=">"

center_tag_open="<center>"
center_tag_close="</center>"

math_block_open="\\["
math_block_close="\\]"
